# Dùng dữ liệu mock trong public/mock (true khi backend chưa xong)
VITE_USE_MOCK=true
# Để trống nếu dùng proxy của Vite; điền URL đầy đủ khi deploy, ví dụ https://api.example.com
VITE_API_BASE_URL=
# Địa chỉ backend cho proxy khi chạy npm run dev
VITE_PROXY_TARGET=http://localhost:8000
# Chu kỳ poll vùng ngập (ms), nên 3000-5000
VITE_POLL_INTERVAL_MS=4000
# Nguồn tile nền. Mặc định là tile OSM (xem chính sách sử dụng); production nên dùng nhà cung cấp có SLA.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
