# Shared device account: every station uses the same MQTT user and password.
# A leaked credential can publish fake telemetry for any station id.
# Acceptable for coursework/LAN demo only; use one account per station in production.
user station-01
topic write flood/station-01/telemetry
topic write flood/station-01/status

user backend
topic read flood/+/telemetry
topic read flood/+/status
